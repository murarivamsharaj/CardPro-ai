    {
      "name": "\uD83D\uDEE1\uFE0F Admin APIs",
      "description": "Admin-only endpoints \u2014 requires JWT with ADMIN role.\n\n**Note:** These endpoints are only accessible to users with `role: \"ADMIN\"`. Regular users will receive a 403 Forbidden response.",
      "item": [
        {
          "name": "\uD83D\uDC65 Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "users"],
              "query": [
                { "key": "page", "value": "0", "description": "Page number (0-based)" },
                { "key": "size", "value": "20", "description": "Page size (max 100)" }
              ]
            },
            "description": "Retrieve a paginated list of all registered users.\n\n**Required Role:** `ADMIN`\n\n**Query Parameters:**\n| Parameter | Type | Default | Description |\n|---|---|---|---|\n| `page` | int | 0 | Page number (0-based) |\n| `size` | int | 20 | Items per page (max 100) |\n\n**Response includes:** id, email, role, leadCredits, createdAt"
          },
          "response": [
            {
              "name": "200 OK \u2014 User List",
              "status": "OK",
              "code": 200,
              "header": [
